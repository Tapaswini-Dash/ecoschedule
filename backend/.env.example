# Copy this file to .env and replace every placeholder locally. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:URL_ENCODED_PASSWORD@localhost:5432/ecoschedule
SECRET_KEY=GENERATE_A_RANDOM_SECRET_WITH_PYTHON
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=SET_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# Optional: set these to choose the demo collectors' login passwords.
# DEMO_COLLECTOR_RASHMI_PASSWORD=
# DEMO_COLLECTOR_MEHTA_PASSWORD=
